{
  "$schema": "https://chickensoft.games/schemas/addons.schema.json",
  "addons": {
    // Install this repo into the hidden workbench the same way a consumer does.
    "aerobeat-tool-image-loader": {
      "url": "..",
      "source": "symlink",
      "subfolder": "/"
    },
    // The public singleton stays vendor-agnostic, but the current truthful backend
    // slice is the landed Godot-native PNG loader package.
    "aerobeat-vendor-godot-image": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-vendor-godot-image.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // Shared tool/workflow contract stays available for future tool-lane expansion.
    "aerobeat-tool-core": {
      "url": "git@github.com:AeroBeat-Workouts/aerobeat-tool-core.git",
      "checkout": "main",
      "subfolder": "/"
    },
    // GUT drives the repo-local test suite inside the hidden testbed/workbench.
    "gut": {
      "url": "git@github.com:bitwes/Gut.git",
      "checkout": "main",
      "subfolder": "/addons/gut"
    }
  }
}
