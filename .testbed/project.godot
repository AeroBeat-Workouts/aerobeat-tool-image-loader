; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AeroBeat Image Loader Testbed"
run/main_scene="res://scenes/image_loader_testbed.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

AeroImageLoader="*res://addons/aerobeat-tool-image-loader/src/AeroImageLoader.gd"
AeroHeadlessManager="*res://addons/aerobeat-tool-headless-manager/src/AeroHeadlessManager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/aerobeat-vendor-godot-unit-test/plugin.cfg")
